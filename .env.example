# Copy to .env.local for local development. Never commit real values.

# Google Tag Manager container (was GTM-TBHW45PH on the old site). Leave empty to load no tracking.
NEXT_PUBLIC_GTM_ID=GTM-TBHW45PH

# Public address of the site, for canonical links, Open Graph and structured data.
NEXT_PUBLIC_SITE_URL=https://midvalleystorage.com

# Contact form: where messages go (comma-separated). UNKNOWN: ask the client.
CONTACT_TO_EMAIL=
# Contact form sending (Resend, same as rapidselfstorage): API key and a verified sender address.
RESEND_API_KEY=
CONTACT_FROM_EMAIL=

# Phase 3 (admin panel): Vercel Blob store and session secret are added then.

# Every setting the site reads. Copy to .env.local for local development and fill in what you need.
# Never commit real values: .env.local is git-ignored. On Vercel, set them under Settings -> Environment Variables
# (then redeploy). DEPLOY.md has the full table: which are required and where each value comes from.

# --- Admin panel (/admin) ---

# Random string of at least 32 characters; signs the admin and Employee Portal cookies (changing it signs everyone out). Generate: openssl rand -base64 48
SESSION_SECRET=
# Email for the very first admin sign-in, which creates the owner account (ignored once any account exists).
ADMIN_EMAIL=
# Password for that first sign-in, at least 10 characters. Delete it from Vercel after the first sign-in.
ADMIN_PASSWORD=

# --- Storage (website content, history, admin users, uploaded photos, contact messages) ---
# Leave both empty locally to use the git-ignored .data/ folder instead.

# Private Vercel Blob store token; added automatically when the store is connected to the project (Vercel -> Storage).
BLOB_READ_WRITE_TOKEN=
# Newer Vercel stores connect with this store id plus Vercel OIDC instead of a token (VERCEL_OIDC_TOKEN, also added by `vercel env pull`). Either one is enough.
BLOB_STORE_ID=

# --- Public site ---

# Public address for canonical links, sitemap, Open Graph and structured data, without a trailing slash (defaults to https://midvalleystorage.com).
NEXT_PUBLIC_SITE_URL=
# Google Tag Manager container id (the old site uses GTM-TBHW45PH). Empty loads no tracking. Needs a redeploy to change.
NEXT_PUBLIC_GTM_ID=

# --- Contact form email (Resend) ---
# Without these, messages are still saved and shown in the admin panel under Messages; they just aren't emailed.

# Who receives contact form messages; several addresses can be separated with commas.
CONTACT_TO_EMAIL=
# Sender address on a domain verified in Resend, for example "Mid Valley Storage <website@your-verified-domain>".
CONTACT_FROM_EMAIL=
# Resend API key (resend.com -> API Keys), with "Sending access".
RESEND_API_KEY=

# --- Employee Portal (/employee) ---

# Shared password staff type to see the schedule. Changing it signs every device out of the portal.
EMPLOYEE_PORTAL_PASSWORD=
# Google Calendar embed address; must start with https://calendar.google.com/ (Calendar settings -> Integrate calendar -> Embed code, the src value).
EMPLOYEE_CALENDAR_EMBED_URL=

# --- Only for `npm run admin:reset` (never set on Vercel) ---

# Optional: the password to give the account instead of a random one (at least 10 characters). Remove it right after use.
# NEW_ADMIN_PASSWORD=
